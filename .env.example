# Server Requirement Validator 설정
# 이 파일을 복사해 같은 폴더에 ".env" 로 저장하고 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# OpenAI API 키 — 넣으면 화면 오른쪽 위 'AI 분석' 토글을 켤 수 있습니다
OPENAI_API_KEY=

# 사용할 모델 (구조화 출력을 지원하는 모델)
SRV_AI_MODEL=gpt-5-mini

# reasoning 지원 모델의 추론 강도: low | medium | high (비우면 보내지 않음)
SRV_AI_EFFORT=low

# AI 를 강제로 끄려면 0 (비워 두면 키가 있을 때 켤 수 있음)
SRV_AI_ENABLED=

# 응답 대기 시간(초)
SRV_AI_TIMEOUT=90

# 프록시·호환 서버(사내 설치형 모델 등)를 쓸 때만 변경
SRV_AI_BASE_URL=https://api.openai.com/v1
