# Server Requirement Validator 설정
# 이 파일을 복사해 같은 폴더에 ".env" 로 저장하고 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# OpenAI API 키 — 넣으면 요구사항 문서 AI 분석이 켜집니다
OPENAI_API_KEY=

# 사용할 모델 (구조화 출력 + reasoning 지원 모델)
SRV_AI_MODEL=gpt-5-mini

# always: 요구사항 문서는 항상 AI로 분석(정확도 우선) / auto: 애매한 문서만 AI로(비용 절약)
SRV_AI_MODE=always

# AI 분석을 강제로 끄려면 0 (비워 두면 키가 있을 때 켜짐)
SRV_AI_ENABLED=

# 응답 대기 시간(초)
SRV_AI_TIMEOUT=90

# 프록시·호환 서버를 쓸 때만 변경
SRV_AI_BASE_URL=https://api.openai.com/v1
